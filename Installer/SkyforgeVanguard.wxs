<!--
  WiX v5 source for the MSI installer (SkyforgeVanguard-<version>.msi), an alternative to the Inno
  Setup .exe. Build it with Installer\build-msi.ps1, which passes the version from Unity's Player
  Settings and the game folder (Builds\Windows).
  Installs for all users into Program Files\Skyforge Vanguard with Start menu and desktop shortcuts.
  A newer MSI upgrades an older one in place; uninstall from Settings > Apps.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Never change the UpgradeCode: it's how Windows knows a newer MSI replaces this game. -->
  <Package Name="Skyforge Vanguard"
           Manufacturer="Rob Anteau"
           Version="$(Version)"
           UpgradeCode="08F4D5CA-D350-42EE-B8BD-85586D410EEE"
           Scope="perMachine"
           Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Skyforge Vanguard is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="GameIcon.exe" SourceFile="$(BuildDir)\Skyforge Vanguard.exe" />
    <Property Id="ARPPRODUCTICON" Value="GameIcon.exe" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Skyforge Vanguard" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Game" Title="Skyforge Vanguard">
      <ComponentGroupRef Id="GameFiles" />
      <ComponentRef Id="Shortcuts" />
    </Feature>

    <!-- Everything in the Unity build, except the debug-symbol folders Unity says not to ship. -->
    <ComponentGroup Id="GameFiles" Directory="INSTALLFOLDER">
      <Files Include="$(BuildDir)\**">
        <Exclude Files="$(BuildDir)\*_BackUpThisFolder_ButDontShipItWithYourGame\**" />
        <Exclude Files="$(BuildDir)\*_BurstDebugInformation_DoNotShip\**" />
      </Files>
    </ComponentGroup>

    <Component Id="Shortcuts" Directory="INSTALLFOLDER">
      <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Skyforge Vanguard"
                Target="[INSTALLFOLDER]Skyforge Vanguard.exe" WorkingDirectory="INSTALLFOLDER" />
      <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="Skyforge Vanguard"
                Target="[INSTALLFOLDER]Skyforge Vanguard.exe" WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKLM" Key="Software\Rob Anteau\Skyforge Vanguard" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
